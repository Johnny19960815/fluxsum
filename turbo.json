{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "i18n:sync": {
      "cache": false
    },
    "i18n:translate": {
      "dependsOn": ["i18n:sync"],
      "cache": false
    },
    "i18n:validate": {
      "cache": false
    },
    "i18n:upload": {
      "dependsOn": ["i18n:translate"],
      "cache": false
    }
  }
}
