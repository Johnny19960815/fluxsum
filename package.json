{
  "name": "fluxsum",
  "version": "0.1.0",
  "private": true,
  "description": "一站式服务全球 - Module Federation 2.0 微前端架构",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "proto:gen": "bun run packages/scripts/proto-gen.ts",
    "i18n:sync": "tsx packages/i18n/scripts/sync.ts",
    "i18n:translate": "tsx packages/i18n/scripts/translate.ts",
    "i18n:validate": "tsx packages/i18n/scripts/validate.ts",
    "i18n:upload": "tsx packages/i18n/scripts/upload-cdn.ts",
    "i18n:gen-go": "tsx packages/i18n/scripts/gen-go.ts",
    "i18n:gen-python": "tsx packages/i18n/scripts/gen-python.ts",
    "i18n": "bun run i18n:sync && bun run i18n:translate && bun run i18n:validate",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^0.8.0",
    "@module-federation/rsbuild-plugin": "^0.8.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  }
}
