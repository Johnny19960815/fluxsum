{
  "name": "@fluxsum/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales/*": "./locales/*",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "locales"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "generate": "tsx scripts/generate.ts",
    "extract": "tsx scripts/extract.ts",
    "validate": "tsx scripts/validate.ts",
    "upload:aliyun": "tsx scripts/upload-aliyun.ts",
    "upload:cloudflare": "tsx scripts/upload-cloudflare.ts",
    "upload": "pnpm upload:aliyun && pnpm upload:cloudflare",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "dependencies": {
    "i18next": "^23.11.5",
    "i18next-http-backend": "^2.5.2"
  },
  "devDependencies": {
    "@fluxsum/typescript-config": "workspace:*",
    "@types/node": "^20.12.7",
    "ali-oss": "^6.20.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "glob": "^10.4.1",
    "tsx": "^4.11.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
