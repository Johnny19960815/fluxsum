{
  "name": "@fluxsum/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "FluxSum 统一多语言体系 - 共享配置、翻译脚本、CDN 加载器",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts"
    },
    "./loader": {
      "types": "./src/loader.ts",
      "import": "./src/loader.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "import": "./src/next/index.ts"
    }
  },
  "scripts": {
    "i18n:translate": "tsx scripts/translate.ts",
    "i18n:sync": "tsx scripts/sync.ts",
    "i18n:validate": "tsx scripts/validate.ts",
    "i18n:upload": "tsx scripts/upload-cdn.ts"
  },
  "dependencies": {
    "i18next": "^24.0.0",
    "react-i18next": "^15.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-resources-to-backend": "^1.2.0",
    "i18next-http-backend": "^3.0.0",
    "rtl-detect": "^1.1.2"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "consola": "^3.2.0",
    "openai": "^4.70.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "glob": "^11.0.0",
    "prettier": "^3.4.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
